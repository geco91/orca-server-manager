# Copy to .env in the repository root; use --env-file .env with Compose.
# For LAN/VPN, explicitly set both bind addresses to that interface's IP.
OSM_BIND_IP=127.0.0.1
OSM_HTTP_PORT=80
OSM_HTTPS_PORT=443
OSM_ORIGIN=https://localhost
OSM_TRUSTED_HOSTS=localhost,127.0.0.1
# Certificate directory; path relative to compose/.
OSM_TLS_DIR=../state/tls
ORCA_BIND_IP=127.0.0.1
ORCA_PORT=6768
ORCA_MEMORY_LIMIT=4g
# Optional browser link only; never include a pairing token here.
ORCA_WEB_URL=
